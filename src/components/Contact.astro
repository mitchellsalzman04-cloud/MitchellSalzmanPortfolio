---
/**
 * Closing band — the azure-to-teal gradient that ends the page, mirroring the
 * full-width statement panel these layouts close on.
 */
import { contact, site } from "@/data/site";
import Band from "@/components/Band.astro";
import ArrowLink from "@/components/ArrowLink.astro";
---

<Band id="contact" tone="accent" class="py-24 md:py-32">
  <div class="max-w-2xl" data-reveal>
    <p class="eyebrow">Contact</p>
    <h2 class="mt-4 text-3xl font-bold sm:text-4xl md:text-5xl">{contact.title}</h2>

    <p class="mt-6 leading-relaxed text-white/85">
      {contact.body.replace(/\s+/g, " ")}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href={`mailto:${site.email}`} class="btn-ghost">Email me</a>
      <ArrowLink href={`mailto:${site.email}`}>{site.email}</ArrowLink>
    </div>

    <p class="mt-10 text-[0.8rem] tracking-[0.14em] text-white/55 uppercase">
      {site.location}
    </p>
  </div>
</Band>

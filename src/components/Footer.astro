---
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";
---

{/*
  Full-bleed, and deliberately outside <main> in Base.astro so it can reach
  both screen edges like the bands above it.

  The affiliation line is not boilerplate. The layout grammar on this site is
  borrowed from medical-device marketing design, and Mitchell interned at
  Medtronic twice — without a disclaimer, a visitor could reasonably read this
  as an official or endorsed page. The palette was already shifted off their
  brand colours for the same reason.
*/}
<footer class="band band-ink">
  <div class="wrap flex flex-col gap-8 py-12 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex gap-5">
      {
        site.socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="text-white/55 transition-colors hover:text-white"
          >
            <Icon name={s.icon} />
          </a>
        ))
      }
    </div>

    <div class="max-w-md text-[0.72rem] leading-relaxed text-white/45 sm:text-right">
      <p>
        Built by {site.name} · design adapted from{" "}
        <a
          href="https://github.com/guilyx/v4"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white/80">guilyx/v4</a
        >
      </p>
    </div>
  </div>
</footer>

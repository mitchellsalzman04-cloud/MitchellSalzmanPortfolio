---
import { site, heroSummary, heroStats, skills } from "@/data/site";
import { withBase } from "@/lib/url";
import Band from "@/components/Band.astro";
---

<Band tone="white" class="pt-28 pb-16 sm:pt-36 sm:pb-24">
  <div class="grid items-start gap-8 md:grid-cols-[1fr_42%]" data-reveal>
    {/* ── Left column: copy ── */}
    <div>
      <p class="eyebrow">Electrical Engineer · Medical Devices</p>

      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl">{site.name}</h1>

      <p class="hero-summary mt-5 max-w-sm text-[0.85rem] leading-relaxed sm:text-[0.9rem]">
        {heroSummary.replace(/\s+/g, " ")}
      </p>

      {/* Accent stat pills */}
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[0.8rem] font-semibold text-accent">
        {heroStats.map((stat) => <span>{stat}</span>)}
      </p>

      {/* CTAs */}
      <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-4">
        <a href={withBase("/#projects")} class="btn">Explore My Work</a>
        <a href={withBase("/about")} class="btn-ghost text-heading">Learn Who I Am</a>
      </div>

      {/* Social links */}
      <div class="mt-5 flex gap-5 text-[0.82rem] font-medium">
        {site.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="link">
            {s.label}
          </a>
        ))}
      </div>

      {/* ── Skills ── */}
      <div class="mt-12 grid gap-6 sm:grid-cols-2 sm:gap-8">
        <div>
          <h3 class="text-[0.7rem] font-semibold uppercase tracking-widest text-muted mb-3">
            Modeling & Tools
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.modeling.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
        <div>
          <h3 class="text-[0.7rem] font-semibold uppercase tracking-widest text-muted mb-3">
            Core Competencies
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.core.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      </div>
    </div>

    {/* ── Right column: photo composition ── */}
    <div class="hero-photos relative mx-auto shrink-0 md:mt-8">
      <img
        src={withBase("/media/mitchell-presenting.jpg")}
        alt="Mitchell Salzman presenting at STRIVE Medical Project Showcase"
        class="hero-photo-main rounded-lg shadow-lg"
      />
      <img
        src={withBase("/media/mitchell-portrait.jpg")}
        alt="Mitchell Salzman professional portrait"
        class="hero-photo-portrait absolute rounded-lg shadow-xl border-4 border-[var(--color-bg)]"
      />
    </div>
  </div>
</Band>

<style>
  .hero-summary {
    background: rgba(12, 95, 203, 0.06);
    padding: 0.35em 0.5em;
    border-radius: 4px;
    display: inline;
    line-height: 1.9;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero-photos {
    width: 100%;
  }

  .hero-photo-main {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .hero-photo-portrait {
    width: 44%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top;
    right: -12px;
    bottom: -48px;
  }
</style>

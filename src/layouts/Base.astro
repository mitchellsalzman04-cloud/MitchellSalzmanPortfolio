---
import "@fontsource-variable/inter";
import "@fontsource-variable/figtree";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Loader from "@/components/Loader.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/url";

interface Props {
  title?: string;
  description?: string;
  /** Intro animation — home page only, and only once per session. */
  loader?: boolean;
}

const { title, description = site.description, loader = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase("/og.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`${site.name} | ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Mark JS availability before first paint so reveal styles apply cleanly.
      document.documentElement.classList.add("has-js");
    </script>
  </head>
  <body>
    {loader && <Loader />}

    <a
      href="#main"
      class="bg-accent fixed top-4 left-4 z-[100] -translate-y-24 rounded-full px-5 py-2 text-sm font-semibold text-white transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>

    <Nav />

    {/*
      No max-width container here — that is deliberate. Sections carry their
      own full-bleed band and re-centre their contents with `.wrap`, which is
      what lets backgrounds run to both screen edges. A wrapper at this level
      would clip every band at max-w-screen-xl and the striped layout would
      collapse back into one column.
    */}
    <main id="main" class="relative z-[1]">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll-reveal: observe [data-reveal] elements once, then unobserve.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>

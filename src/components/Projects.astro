---
import Section from "@/components/Section.astro";
import Icon from "@/components/Icon.astro";
import { projects, layers, buildsIntro } from "@/data/site";
import { withBase } from "@/lib/url";

/**
 * Projects — big alternating spotlights, the shape Brittany Chiang's v4
 * established for this genre.
 *
 * There is no second tier any more. The old layout put three projects in
 * spotlights and swept the rest into an "Other noteworthy projects" grid,
 * which ranked them in public: anything in the grid read as the stuff that
 * didn't make the cut. Every project gets the same treatment now, and order
 * is the only ranking left — so site.ts is ordered strongest first.
 *
 * The spotlights deliberately do NOT use a full-card overlay link: these
 * carry promo clips where one exists, and an overlay would sit on top of the
 * video and swallow the play button. Links here are explicit instead.
 */
---

<Section id="projects" title="Projects" eyebrow="What I've Built" tone="grey">
  <p class="text-muted mb-14 max-w-xl text-sm" data-reveal>
    {buildsIntro.replace(/\s+/g, " ")}
  </p>

  <ul class="space-y-16 md:space-y-28">
    {
      projects.map((p, i) => (
        <li
          class="group relative grid items-center gap-x-10 gap-y-5 md:grid-cols-2"
          data-reveal
        >
          {/* Media */}
          <div class={`relative ${i % 2 === 0 ? "md:order-2" : "md:order-1"}`}>
            {p.video && p.videoAutoplay && p.sideImages ? (
              /* Autoplay video + first sideImage side-by-side */
              <div class="grid grid-cols-2 gap-3">
                <div class="border-line overflow-hidden rounded-lg border bg-black/5 aspect-[3/4]">
                  <video
                    autoplay
                    muted
                    loop
                    playsinline
                    aria-label={`${p.title} demo`}
                    class="block h-full w-full object-cover object-[center_80%]"
                  >
                    <source src={withBase(p.video!)} type={p.videoType ?? "video/mp4"} />
                  </video>
                </div>
                <div class="border-line overflow-hidden rounded-lg border">
                  <img
                    src={withBase(p.sideImages[0].src)}
                    alt={p.sideImages[0].alt}
                    class="block h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              </div>
            ) : p.coverImage && p.video ? (
              /* Rotated video filling the media column */
              <div class="relative w-full aspect-video overflow-hidden rounded-lg border border-line bg-black/5 shadow-lg">
                <video
                  controls
                  playsinline
                  preload="metadata"
                  aria-label={`${p.title} demo`}
                  class="absolute top-1/2 left-1/2 h-[178%] w-auto -translate-x-1/2 -translate-y-1/2 rotate-video-ccw"
                >
                  <source src={withBase(p.video!)} type={p.videoType ?? "video/mp4"} />
                </video>
              </div>
            ) : p.video && p.videoAutoplay ? (
              <div class="border-line overflow-hidden rounded-lg border bg-black/5 aspect-[4/3] flex items-center justify-center">
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  aria-label={`${p.title} demo`}
                  class="block h-full w-full object-cover rotate-video-cw"
                >
                  <source src={withBase(p.video!)} type={p.videoType ?? "video/mp4"} />
                </video>
              </div>
            ) : p.video ? (
              <div class="border-line overflow-hidden rounded-lg border bg-black/5">
                <video
                  controls
                  playsinline
                  preload="none"
                  poster={p.videoPoster}
                  aria-label={`${p.title} demo`}
                  class="block w-full"
                >
                  <source src={withBase(p.video!)} type={p.videoType ?? "video/mp4"} />
                </video>
              </div>
            ) : p.interactive3d ? (
              <div class="relative w-full overflow-hidden rounded-lg border border-[var(--color-line)]" style="height: 380px;">
                <canvas data-syndex-3d class="block h-full w-full"></canvas>
                <div class="pointer-events-none absolute bottom-2 left-2 text-[0.65rem] text-[var(--color-muted)]">Drag to orbit · Scroll to zoom</div>
              </div>
            ) : p.coverImage ? (
              <div class="flex items-center justify-center">
                <img
                  src={withBase(p.coverImage.src)}
                  alt={p.coverImage.alt}
                  class="block max-h-[34rem] w-auto object-contain drop-shadow-lg"
                  loading="lazy"
                />
              </div>
            ) : p.sideImages ? (
              <div class="grid grid-cols-1 gap-3">
                {p.sideImages.map((img) => (
                  <div class="border-line overflow-hidden rounded-lg border">
                    <img
                      src={withBase(img.src)}
                      alt={img.alt}
                      class="block w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            ) : (
              <div
                class={`${["panel", "panel-alt", "panel-deep"][i % 3]} flex aspect-[4/3] items-end rounded-lg p-7`}
              >
                <span class="font-display text-2xl font-bold text-white/90 sm:text-3xl">
                  {p.title}
                </span>
              </div>
            )}
            {p.sideImages && !p.videoAutoplay && (p.video || p.coverImage) && (
              <div class="mt-3 grid grid-cols-2 gap-3">
                {p.sideImages.map((img) => (
                  <div class="border-line overflow-hidden rounded-lg border">
                    <img
                      src={withBase(img.src)}
                      alt={img.alt}
                      class="block w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Copy */}
          <div
            class={`relative ${
              i % 2 === 0 ? "md:order-1 md:text-left" : "md:order-2 md:text-right"
            }`}
          >
            <p class="eyebrow mb-3">{p.layerLabel ?? layers[p.layer]}</p>
            <h3 class="text-xl font-bold sm:text-2xl">
              {p.external ?? p.github ? (
                <a
                  href={p.external ?? p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent transition-colors"
                >
                  {p.title}
                </a>
              ) : (
                p.title
              )}
            </h3>
            <div class="card mt-4 p-5">
              <ul class="text-body space-y-2 text-[0.9rem]">
                {p.bullets.map((b) => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-current" />
                    {b}
                  </li>
                ))}
              </ul>
            </div>
            <ul
              class={`mt-5 flex flex-wrap gap-x-4 gap-y-1 ${
                i % 2 === 0 ? "" : "md:justify-end"
              }`}
            >
              {p.tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
            <div
              class={`mt-5 flex items-center gap-4 ${i % 2 === 0 ? "" : "md:justify-end"}`}
            >
              {p.closed && (
                <span class="text-faint text-[0.68rem]" title="Closed source">
                  closed
                </span>
              )}
              {p.github && (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.title} on GitHub`}
                  class="text-muted hover:text-accent transition-colors"
                >
                  <Icon name="github" size={20} />
                </a>
              )}
              {p.external && (
                <a
                  href={p.external}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted hover:text-accent inline-flex items-center gap-2 text-xs transition-colors"
                >
                  {p.externalLabel ?? "Visit"}
                  <Icon name="external" size={14} />
                </a>
              )}
              {p.detailPage && (
                <a
                  href={withBase(p.detailPage)}
                  class="text-accent hover:text-heading inline-flex items-center gap-2 text-sm font-medium transition-colors"
                >
                  Deep dive
                  <Icon name="arrow" size={14} />
                </a>
              )}
            </div>
            {p.bottomImage && (
              <div class="border-line mt-5 overflow-hidden rounded-lg border">
                <img
                  src={withBase(p.bottomImage.src)}
                  alt={p.bottomImage.alt}
                  class="block w-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {/* The archive link used to hang off the "other noteworthy" heading. It
      still belongs on the page — it's the full list, not a lesser one. */}
  <p class="mt-20 text-center" data-reveal>
    <a href={withBase("/archive")} class="link text-sm">view the archive</a>
  </p>
</Section>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline>
(function(){
  var canvas = document.querySelector('[data-syndex-3d]');
  if (!canvas) return;
  var rect = canvas.parentElement.getBoundingClientRect();
  var W = rect.width, H = rect.height;
  var scene = new THREE.Scene();
  var dk = window.matchMedia('(prefers-color-scheme: dark)').matches;
  scene.background = new THREE.Color(dk ? 0x1a1a1a : 0xf0efe8);

  var camera = new THREE.PerspectiveCamera(34, W/H, 0.1, 100);
  var renderer = new THREE.WebGLRenderer({canvas: canvas, antialias: true});
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  scene.add(new THREE.AmbientLight(0xffffff, 0.5));
  var d1 = new THREE.DirectionalLight(0xffffff, 0.8);
  d1.position.set(5,8,6); scene.add(d1);
  scene.add(new THREE.DirectionalLight(0x99aacc, 0.3).translateX(-4).translateY(3).translateZ(-5));

  var mA = new THREE.MeshStandardMaterial({color:0xd5d5cd,roughness:0.3,metalness:0.65});
  var mS = new THREE.MeshStandardMaterial({color:0xbbbbb3,roughness:0.4,metalness:0.5});
  var mF = new THREE.MeshStandardMaterial({color:0xc8c8c0,roughness:0.3,metalness:0.6});
  var mFS = new THREE.MeshStandardMaterial({color:0xb0b0a8,roughness:0.4,metalness:0.5});
  var mM = new THREE.MeshStandardMaterial({color:0x1a1a1a,roughness:0.4,metalness:0.5});
  var mC = new THREE.MeshStandardMaterial({color:0x3a3a38,roughness:0.35,metalness:0.6});
  var mSh = new THREE.MeshStandardMaterial({color:0xcccccc,roughness:0.15,metalness:0.9});
  var mB = new THREE.MeshStandardMaterial({color:0x555555,roughness:0.3,metalness:0.7});
  var mCr = new THREE.MeshStandardMaterial({color:0x444440,roughness:0.45,metalness:0.55});
  var mP = new THREE.MeshStandardMaterial({color:0x555550,roughness:0.4,metalness:0.5});
  var mJ = new THREE.MeshStandardMaterial({color:0xbbbbbb,roughness:0.15,metalness:0.85});
  var mG = new THREE.MeshStandardMaterial({color:0x1a1a1a,roughness:0.8,metalness:0.1});
  var mT = new THREE.MeshStandardMaterial({color:0x555550,roughness:0.5,metalness:0.3});
  var mL = new THREE.MeshStandardMaterial({color:0x999990,roughness:0.3,metalness:0.6});

  function fb(f,t){var g=new THREE.Group();var d=new THREE.Vector3(t[0]-f[0],t[1]-f[1],t[2]-f[2]);var l=d.length();var m=new THREE.Mesh(new THREE.BoxGeometry(0.10,0.10,l),mF);m.position.set((f[0]+t[0])/2,(f[1]+t[1])/2,(f[2]+t[2])/2);m.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1),d.clone().normalize());g.add(m);var s1=new THREE.Mesh(new THREE.BoxGeometry(0.04,0.015,l),mFS);s1.position.copy(m.position);s1.quaternion.copy(m.quaternion);s1.translateY(0.05);g.add(s1);return g;}

  function ext(l,a){var g=new THREE.Group();var pw=0.18,ph=0.18;var geo=a==='y'?new THREE.BoxGeometry(pw,l,ph):a==='z'?new THREE.BoxGeometry(pw,ph,l):new THREE.BoxGeometry(l,ph,pw);g.add(new THREE.Mesh(geo,mA));if(a==='x'){g.add(new THREE.Mesh(new THREE.BoxGeometry(l,0.025,0.06),mS).translateY(ph/2));g.add(new THREE.Mesh(new THREE.BoxGeometry(l,0.025,0.06),mS).translateY(-ph/2));}else if(a==='y'){g.add(new THREE.Mesh(new THREE.BoxGeometry(0.025,l,0.06),mS).translateX(pw/2));g.add(new THREE.Mesh(new THREE.BoxGeometry(0.025,l,0.06),mS).translateX(-pw/2));}else{g.add(new THREE.Mesh(new THREE.BoxGeometry(0.025,0.06,l),mS).translateX(pw/2));g.add(new THREE.Mesh(new THREE.BoxGeometry(0.025,0.06,l),mS).translateX(-pw/2));}return g;}

  function nm(sz){var g=new THREE.Group();var dp=sz*0.9;g.add(new THREE.Mesh(new THREE.BoxGeometry(sz,sz,dp),mM));var c=new THREE.Mesh(new THREE.CylinderGeometry(sz*0.38,sz*0.38,0.012,16),mC);c.rotation.x=Math.PI/2;c.position.z=dp/2;g.add(c);var s=new THREE.Mesh(new THREE.CylinderGeometry(0.022,0.022,0.14,8),mSh);s.rotation.x=Math.PI/2;s.position.z=dp/2+0.07;g.add(s);return g;}

  function cr(a){return new THREE.Mesh(a==='x'?new THREE.BoxGeometry(0.16,0.26,0.26):a==='y'?new THREE.BoxGeometry(0.26,0.16,0.26):new THREE.BoxGeometry(0.26,0.26,0.16),mCr);}

  var hw=0.8,hd=0.8,cH=2.0;
  var cg=new THREE.Group();
  cg.add(fb([-hw,0,-hd],[hw,0,-hd]));cg.add(fb([-hw,0,hd],[hw,0,hd]));cg.add(fb([-hw,0,-hd],[-hw,0,hd]));cg.add(fb([hw,0,-hd],[hw,0,hd]));
  cg.add(fb([-hw,cH,-hd],[hw,cH,-hd]));cg.add(fb([-hw,cH,-hd],[-hw,cH,hd]));
  cg.add(fb([-hw,0,-hd],[-hw,cH,-hd]));cg.add(fb([hw,0,-hd],[hw,cH,-hd]));cg.add(fb([-hw,0,hd],[-hw,cH,hd]));
  scene.add(cg);

  var RL=1.8,rY=0.22;
  scene.add(ext(RL,'x').translateY(rY));
  var m1=nm(0.24);m1.rotation.y=Math.PI/2;m1.position.set(-RL/2-0.20,rY,0);scene.add(m1);
  var c1=cr('x');c1.position.set(0.15,rY,0);scene.add(c1);
  scene.add(new THREE.Mesh(new THREE.BoxGeometry(0.20,0.03,0.20),mP).translateX(0.15).translateY(rY+0.145));

  var r2=ext(RL,'z');r2.position.set(0.15,rY+0.265,0);scene.add(r2);
  var m2=nm(0.24);m2.rotation.y=Math.PI;m2.position.set(0.15,rY+0.265,-RL/2-0.20);scene.add(m2);
  var c2=cr('z');c2.position.set(0.15,rY+0.265,0.25);scene.add(c2);
  scene.add(new THREE.Mesh(new THREE.BoxGeometry(0.03,0.20,0.20),mP).translateX(0.295).translateY(rY+0.265).translateZ(0.25));

  var r3=ext(1.5,'y');r3.position.set(0.415,rY+0.265,0.25);scene.add(r3);
  var m3=nm(0.24);m3.rotation.x=-Math.PI/2;m3.position.set(0.415,rY+0.265+0.95,0.25);scene.add(m3);
  var c3=cr('y');c3.position.set(0.415,rY-0.05,0.25);scene.add(c3);

  var aX=0.545,aY=rY-0.05,aZ=0.25;
  var arm=new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.02,0.20,6),mL);arm.rotation.x=Math.PI/2;arm.position.set(aX,aY,aZ+0.10);scene.add(arm);
  var bZ=aZ+0.22;
  scene.add(new THREE.Mesh(new THREE.SphereGeometry(0.09,16,16),mJ).translateX(aX).translateY(aY).translateZ(bZ));
  scene.add(new THREE.Mesh(new THREE.TorusGeometry(0.09,0.016,8,16),mC).translateX(aX).translateY(aY).translateZ(bZ).rotateY(Math.PI/2));

  var gp=new THREE.Group();
  var bl=new THREE.Mesh(new THREE.CylinderGeometry(0.055,0.06,0.30,12),mG);bl.rotation.x=Math.PI/2;bl.position.set(0,0,0.15);gp.add(bl);
  gp.add(new THREE.Mesh(new THREE.SphereGeometry(0.055,12,8,0,Math.PI*2,0,Math.PI/2),mC).translateZ(0.30).rotateX(-Math.PI/2));
  gp.add(new THREE.Mesh(new THREE.CylinderGeometry(0.068,0.058,0.025,12),mC).translateZ(0).rotateX(Math.PI/2));
  var hd2=new THREE.Mesh(new THREE.BoxGeometry(0.08,0.30,0.09),mG);hd2.position.set(0,-0.20,0.06);hd2.rotation.x=-0.22;gp.add(hd2);
  gp.add(new THREE.Mesh(new THREE.BoxGeometry(0.085,0.04,0.10),mG).translateY(-0.35).translateZ(0.13).rotateX(-0.22));
  var gd=new THREE.Mesh(new THREE.TorusGeometry(0.06,0.009,6,12,Math.PI),mT);gd.position.set(0,-0.08,0.11);gd.rotation.set(Math.PI/2,0,0);gp.add(gd);
  gp.add(new THREE.Mesh(new THREE.BoxGeometry(0.015,0.07,0.025),mT).translateY(-0.06).translateZ(0.10).rotateX(0.15));
  gp.add(new THREE.Mesh(new THREE.CylinderGeometry(0.02,0.02,0.10,6),mL).translateZ(-0.05).rotateX(Math.PI/2));
  gp.position.set(aX,aY,bZ);scene.add(gp);

  var grid=new THREE.GridHelper(6,12,dk?0x333333:0xdddddd,dk?0x2a2a2a:0xeeeeee);grid.position.y=-0.08;scene.add(grid);

  var isD=false,px2=0,py2=0,th=0.9,ph=0.50,rad=5.5;
  function cam(){camera.position.set(rad*Math.sin(ph)*Math.cos(th),rad*Math.cos(ph)+0.6,rad*Math.sin(ph)*Math.sin(th));camera.lookAt(0,0.7,0.1);}
  cam();
  canvas.addEventListener('pointerdown',function(e){isD=true;px2=e.clientX;py2=e.clientY;canvas.setPointerCapture(e.pointerId);});
  canvas.addEventListener('pointermove',function(e){if(!isD)return;th-=(e.clientX-px2)*0.007;ph=Math.max(0.15,Math.min(1.45,ph+(e.clientY-py2)*0.007));px2=e.clientX;py2=e.clientY;cam();});
  canvas.addEventListener('pointerup',function(){isD=false;});
  canvas.addEventListener('wheel',function(e){e.preventDefault();rad=Math.max(2.5,Math.min(14,rad+e.deltaY*0.008));cam();},{passive:false});

  (function a(){requestAnimationFrame(a);if(!isD){th+=0.0012;cam();}renderer.render(scene,camera);})();
  window.addEventListener('resize',function(){var r=canvas.parentElement.getBoundingClientRect();camera.aspect=r.width/r.height;camera.updateProjectionMatrix();renderer.setSize(r.width,r.height);});
})();
</script>

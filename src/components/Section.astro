---
/**
 * Section wrapper — now a full-bleed band with an eyebrow header.
 *
 * The eyebrow (small uppercase label with a rule under it) is the device that
 * ties the page together visually; it appears above every section heading the
 * way category labels do on medical-device marketing sites.
 */
import Band from "@/components/Band.astro";

interface Props {
  id: string;
  title: string;
  /** Small uppercase label above the heading. Defaults to the section id. */
  eyebrow?: string;
  tone?: "white" | "grey" | "dark" | "ink" | "hero" | "accent";
  class?: string;
}

const { id, title, eyebrow, tone = "white", class: className = "" } = Astro.props;
---

<Band id={id} tone={tone} class={`py-20 md:py-28 ${className}`}>
  <header class="mb-12 max-w-3xl" data-reveal>
    <p class="eyebrow">{eyebrow ?? id}</p>
    <h2 class="mt-4 text-2xl font-bold sm:text-3xl md:text-4xl">{title}</h2>
  </header>
  <slot />
</Band>

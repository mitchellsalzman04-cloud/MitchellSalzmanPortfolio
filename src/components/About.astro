---
import Section from "@/components/Section.astro";
import { about } from "@/data/site";

/** Tiny markdown-link renderer for the about paragraphs. */
function md(text: string): string {
  return text
    .replace(/\s+/g, " ")
    .replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener noreferrer" class="link">$1</a>',
    );
}
---

{/*
  The portrait used to live here. It moved to the hero panel, where it gets
  prime placement on the gradient — running the same keyed illustration twice
  on one page read as padding rather than design.
*/}
<Section id="about" title="Background" eyebrow="Who I Am" tone="grey">
  <div class="max-w-3xl space-y-5 text-[0.97rem] leading-relaxed" data-reveal>
    {about.paragraphs.map((p) => <p set:html={md(p)} />)}
  </div>
</Section>
